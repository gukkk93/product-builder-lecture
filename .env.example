# Copy this file to .env.local (gitignored) for local dev, and set the same
# keys as environment variables in the Cloudflare Pages project settings for
# production. Without VITE_POSTHOG_KEY set, analytics stays a safe no-op.

# PostHog project API key (Project Settings -> Project API Key in your
# PostHog project). Free tier at https://posthog.com is enough to start.
VITE_POSTHOG_KEY=

# Optional — only needed if your PostHog project isn't on US Cloud.
# EU Cloud: https://eu.i.posthog.com
VITE_POSTHOG_HOST=

# Paddle client-side token (Developer Tools -> Authentication -> Client-side
# tokens in the Paddle dashboard) — this one is designed to be public, safe
# to ship in the frontend bundle. Used by src/pages/Credits.jsx to open the
# Paddle.js checkout overlay. Without it, /credits shows a friendly
# "not set up yet" message instead of crashing.
VITE_PADDLE_CLIENT_TOKEN=

# 'sandbox' or 'production' — must match which environment the client token
# above came from (a sandbox token only works with environment: 'sandbox').
VITE_PADDLE_ENV=sandbox

# NOT prefixed with VITE_ — this one is a secret and must never end up in
# the client bundle. Only used locally by scripts/setup-paddle.mjs (never
# read at runtime by the deployed app) to create the credit pack product/
# prices/webhook via the Paddle API. Get it from Developer Tools ->
# Authentication -> API keys in the Paddle dashboard
# (needs product.write/price.write/notification_setting.write).
PADDLE_API_KEY=

# Same environment selector as VITE_PADDLE_ENV, but read only by
# scripts/setup-paddle.mjs to pick the sandbox vs live Paddle API base URL.
PADDLE_ENV=sandbox

# Server-side only — read by functions/webhooks/paddle.js to verify Paddle's
# webhook signature. Set via scripts/setup-paddle.mjs (appended to
# .env.local automatically) after registering the webhook destination; the
# deployed app reads this from Cloudflare Pages' own Environment variables
# (Secret), not from this file — .env.local only matters for local testing.
PADDLE_WEBHOOK_SECRET=
