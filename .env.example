# Copy this file to .env.local (gitignored) for local dev, and set the same
# keys as environment variables in the Cloudflare Pages project settings for
# production. Without VITE_POSTHOG_KEY set, analytics stays a safe no-op.

# PostHog project API key (Project Settings -> Project API Key in your
# PostHog project). Free tier at https://posthog.com is enough to start.
VITE_POSTHOG_KEY=

# Optional — only needed if your PostHog project isn't on US Cloud.
# EU Cloud: https://eu.i.posthog.com
VITE_POSTHOG_HOST=
